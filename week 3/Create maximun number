class Solution:
    def maxNumber(self, nums1: list[int], nums2: list[int], k: int) -> list[int]:
        m, n = len(nums1), len(nums2)
        best_combination = []
        def max_subsequence(nums, length):
            stack = []
            drop = len(nums) - length
            for num in nums:
                while drop > 0 and stack and stack[-1] < num:
                    stack.pop()
                    drop -= 1
                stack.append(num)
            return stack[:length]
        def merge(sub1, sub2):
            return [max(sub1, sub2).pop(0) for _ in range(len(sub1) + len(sub2))]
        start_i = max(0, k - n)
        end_i = min(k, m)
        
        for i in range(start_i, end_i + 1):
            sub1 = max_subsequence(nums1, i)
            sub2 = max_subsequence(nums2, k - i)
            candidate = merge(sub1, sub2)
            if candidate > best_combination:
                best_combination = candidate
                
        return best_combination
