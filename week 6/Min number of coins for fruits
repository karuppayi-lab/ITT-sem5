class Solution:
    def minimumCoins(self, prices: list[int]) -> int:
        n = len(prices)
        # dp[i] will store the minimum coins needed to acquire all fruits from index i to n.
        # We size it to n + 2 to easily handle out-of-bound transitions.
        dp = [0] * (n + 2)
        
        # Start from the last fruit and work backwards
        for i in range(n, 0, -1):
            # If buying fruit i covers all remaining fruits, we only pay for fruit i
            if i + i >= n:
                dp[i] = prices[i - 1]
            else:
                # Otherwise, we find the minimum cost among all next states we could transition to
                # The next fruit we MUST buy will be somewhere between i + 1 and 2i + 1
                next_choices = dp[i + 1 : 2 * i + 2]
                dp[i] = prices[i - 1] + min(next_choices)
                
        return dp[1]
