class Solution:
    def jump(self, nums: list[int]) -> int:
        n = len(nums)
        if n <= 1:
            return 0
            
        jumps = 0
        current_end = 0
        farthest = 0
        
        # We don't need to process the last index because once we reach 
        # or can cross n-1, we stop.
        for i in range(n - 1):
            # Update the furthest index reachable from current spot
            farthest = max(farthest, i + nums[i])
            
            # If we've reached the end of the current jump's coverage
            if i == current_end:
                jumps += 1
                current_end = farthest
                
                # Optimization: If we can already reach the last index, break early
                if current_end >= n - 1:
                    break
                    
        return jumps
