class Solution:
    def peopleAwareOfSecret(self, n: int, delay: int, forget: int) -> int:
        MOD = 10**9 + 7
        
        # dp[i] stores the number of people who find out about the secret on day i
        dp = [0] * (n + 1)
        dp[1] = 1 # Day 1 starts with 1 person
        
        # Tracks the number of people currently eligible to share the secret
        sharing_count = 0
        
        for i in range(2, n + 1):
            # 1. Add people who just reached their 'delay' milestone and can now share
            if i - delay >= 1:
                sharing_count = (sharing_count + dp[i - delay]) % MOD
                
            # 2. Subtract people who just reached their 'forget' milestone and can no longer share
            if i - forget >= 1:
                sharing_count = (sharing_count - dp[i - forget] + MOD) % MOD
                
            # 3. The number of new people who learn the secret today is equal to sharing_count
            dp[i] = sharing_count
            
        # The total number of people who know the secret at the end of day n 
        # is the sum of all people who learned it within the window [n - forget + 1, n]
        ans = 0
        for i in range(max(1, n - forget + 1), n + 1):
            ans = (ans + dp[i]) % MOD
            
        return ans
