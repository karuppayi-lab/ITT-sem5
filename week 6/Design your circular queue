#include <vector>
class MyCircularQueue {
private:
    std::vector<int> queue;
    int head;
    int tail;
    int max_size;

public:
    MyCircularQueue(int k) {
        queue.resize(k);
        max_size = k;
        head = -1;
        tail = -1;
    }
    bool enQueue(int value) {
        if (isFull()) {
            return false;
        }
        if (isEmpty()) {
            head = 0;
        }
        // Move tail circularly
        tail = (tail + 1) % max_size;
        queue[tail] = value;
        return true;
    }
    bool deQueue() {
        if (isEmpty()) {
            return false;
        }
        // If there is only one element left, reset pointers
        if (head == tail) {
            head = -1;
            tail = -1;
        } else {
            // Move head circularly
            head = (head + 1) % max_size;
        }
        return true;
    }  
    int Front() {
        if (isEmpty()) {
            return -1;
        }
        return queue[head];
    }
    int Rear() {
        if (isEmpty()) {
            return -1;
        }
        return queue[tail];
    }
    bool isEmpty() {
        return head == -1;
    }
    bool isFull() {
        return (tail + 1) % max_size == head;
    }
};
